VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-browser-publishable-key
# Public configuration: exact human Auth UUID; database RLS is the security boundary.
VITE_OWNER_AUTH_USER_ID=
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
# Optional browser-visible weather configuration (never put server secrets here).
VITE_WEATHERAPI_KEY=
